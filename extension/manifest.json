{
  "manifest_version": 3,
  "name": "마켓 주문상세 → The.Mango 전송",
  "version": "1.7.0",
  "description": "롯데온·SSG·무신사·네이버페이·패션플러스·지마켓 주문상세 정보를 클릭 한 번으로 The.Mango 주문건에 옮기고 주문상태를 배송완료로 변경합니다.",
  "permissions": ["tabs", "scripting", "notifications", "storage"],
  "host_permissions": [
    "https://www.lotteon.com/*",
    "https://pay.ssg.com/*",
    "https://www.musinsa.com/*",
    "https://orders.pay.naver.com/*",
    "https://www.fashionplus.co.kr/*",
    "https://my.gmarket.co.kr/*",
    "https://pay.musinsapayments.com/*",
    "https://dashboard.tosspayments.com/*",
    "https://tmg4087.mycafe24.com/*",
    "http://127.0.0.1:8787/*"
  ],
  "icons": { "16": "icon16.png", "48": "icon48.png", "128": "icon128.png" },
  "action": {
    "default_title": "다른 브라우저에서 넘어온 주문건 반영하기",
    "default_icon": { "16": "icon16.png", "48": "icon48.png", "128": "icon128.png" }
  },
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://www.lotteon.com/p/order/claim/orderDetail*"],
      "js": ["common.js", "lotteon.js"],
      "css": ["site.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://pay.ssg.com/myssg/orderInfoDetail.ssg*"],
      "js": ["common.js", "ssg.js"],
      "css": ["site.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.musinsa.com/order/*"],
      "js": ["common.js", "musinsa.js"],
      "css": ["site.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://orders.pay.naver.com/order/*"],
      "js": ["common.js", "naver.js"],
      "css": ["site.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.fashionplus.co.kr/mypage/order/detail/*"],
      "js": ["common.js", "fashionplus.js"],
      "css": ["site.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://my.gmarket.co.kr/ko/pc/*"],
      "js": ["common.js", "gmarket.js"],
      "css": ["site.css"],
      "run_at": "document_idle"
    }
  ]
}
